{
  "name": "picomposer-mcp",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "private": true,
  "type": "module",
  "description": "MCP server for picomposer generative UI: exposes mouse, broadcast, and last-message contexts as resources and generative UI tools with strict PII redaction.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0"
  },
  "pi": {
    "service": "picomposer-mcp",
    "displayName": "PiComposer MCP",
    "layer": "Control plane",
    "port": 3601,
    "ports": {},
    "healthEndpoint": "/health",
    "envPortVar": "PICOMPOSER_MCP_PORT"
  }
}
